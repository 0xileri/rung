# Copy to .env.local and fill in. .env.local is gitignored: an RPC URL with an embedded
# API key is a credential, and it must not end up in the repo -- including in this file.

# Devnet RPC for deploy and seeding scripts. Leave empty to use public devnet.
# Helius:    https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# QuickNode: https://YOUR-ENDPOINT.solana-devnet.quiknode.pro/YOUR_TOKEN/
DEVNET_RPC_URL=

# Mainnet RPC, used server-side to read PreStocks mint state (extensions, fee schedule).
# The public endpoint works but rate-limits.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Server-only RPC for the web app's own chain reads. Safe for a keyed URL: only
# NEXT_PUBLIC_ variables are shipped to browsers.
SOLANA_SERVER_RPC_URL=

# What the BROWSER talks to. Every NEXT_PUBLIC_ value is compiled into the page that every
# visitor downloads, so never put a keyed URL here. Leave empty for public devnet.
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_CLUSTER=devnet

# Devnet faucet wallet (the JSON array written by scripts/setup-faucet.ts). Server-only.
FAUCET_SECRET_KEY=
