# Copy to .env.local and fill in. .env.local is gitignored: an RPC URL with an embedded
# API key is a credential, and it must not end up in the repo.

# Devnet RPC used for deploying and for the app's program reads.
# Helius:    https://devnet.helius-rpc.com/?api-key=de37a79d-1899-4384-a1ff-8655b3804ed1
# QuickNode: https://YOUR-ENDPOINT.solana-devnet.quiknode.pro/YOUR_TOKEN/
DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=de37a79d-1899-4384-a1ff-8655b3804ed1

# Mainnet RPC, used server-side to read PreStocks mint state (extensions, fee schedule).
# The public endpoint works but rate-limits; the same paid key usually covers mainnet too.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# What the browser talks to. Same value as DEVNET_RPC_URL in most setups.
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_CLUSTER=devnet

