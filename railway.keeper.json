{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "echo 'keeper: nothing to build, it runs scripts/keeper.ts directly'",
    "watchPatterns": ["scripts/keeper.ts", "packages/sdk/**", "package.json", "package-lock.json", "railway.keeper.json"]
  },
  "deploy": {
    "startCommand": "node scripts/keeper.ts --once",
    "cronSchedule": "*/10 * * * *",
    "restartPolicyType": "NEVER"
  }
}
